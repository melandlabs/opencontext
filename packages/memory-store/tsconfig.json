{
	"extends": "../config/src/tsconfig.json",
	"compilerOptions": {
		"outDir": "./dist",
		"incremental": false,
		"tsBuildInfoFile": "./dist/.tsbuildinfo",
		"noEmit": false,
		"paths": {
			"@melandlabs/indexeddb": ["../../packages/indexeddb/src/index.ts"],
			"@melandlabs/indexeddb/*": ["../../packages/indexeddb/src/*"],
			"@melandlabs/sqlite": ["../../packages/sqlite/src/index.ts"],
			"@melandlabs/sqlite/*": ["../../packages/sqlite/src/*"],
			"@melandlabs/ai": ["../../packages/ai/src/index.ts"],
			"@melandlabs/ai/*": ["../../packages/ai/src/*"],
			"@melandlabs/ai-rag": ["../../packages/ai/rag/src/index.ts"],
			"@melandlabs/ai-rag/*": ["../../packages/ai/rag/src/*"],
			"@melandlabs/rag": ["../../packages/rag/src/index.ts"],
			"@melandlabs/rag/*": ["../../packages/rag/src/*"],
			"@melandlabs/shared": ["../../packages/shared/src/index.ts"],
			"@melandlabs/shared/*": ["../../packages/shared/src/*"]
		}
	},
	"include": ["src"]
}
