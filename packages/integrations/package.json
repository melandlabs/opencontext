{
	"name": "@melandlabs/integrations",
	"version": "0.2.0",
	"type": "module",
	"files": ["dist", "README.md", "LICENSE"],
	"publishConfig": {
		"access": "public"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": "./dist/index.js",
		"./core": "./dist/core-index.js",
		"./contacts": "./dist/contacts.js",
		"./utils": "./dist/utils-index.js",
		"./utils/email-content-cleaner": "./dist/utils-email-content-cleaner.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/melandlabs/opencontext.git",
		"directory": "packages/integrations"
	},
	"homepage": "https://github.com/melandlabs/opencontext/tree/main/packages/integrations",
	"bugs": {
		"url": "https://github.com/melandlabs/opencontext/issues"
	},
	"license": "Apache-2.0",
	"description": "Unified package for opencontext integration packages. Re-exports shared core interfaces, contacts utilities, and content utilities. Install each integration (e.g. @melandlabs/integrations-telegram) separately.",
	"keywords": ["opencontext", "integrations", "core", "contacts", "utils"],
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"dependencies": {
		"sanitize-html": "^2.17.6",
		"turndown": "^7.2.4"
	},
	"devDependencies": {
		"@types/sanitize-html": "^2.16.1",
		"@types/turndown": "^5.0.6"
	}
}
