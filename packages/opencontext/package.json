{
	"name": "@melandlabs/opencontext",
	"version": "0.1.0",
	"type": "module",
	"description": "OpenContext — single-package facade that bundles the contracts, memory-store, retrieval, loop engine, and agent runtime. Install once, get every capability.",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"opencontext": "./dist/cli/opencontext.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"license": "Apache-2.0",
	"keywords": [
		"opencontext",
		"melandlabs",
		"memory",
		"rag",
		"agent",
		"temporal-graph",
		"mcp",
		"llm"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/melandlabs/opencontext.git",
		"directory": "packages/opencontext"
	},
	"dependencies": {
		"@hono/node-server": "^1.13.7",
		"@modelcontextprotocol/sdk": "^1.25.3",
		"better-sqlite3": "^11.10.0",
		"hono": "^4.6.14",
		"pg": "^8.13.0",
		"sqlite-vec": "^0.1.7",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@melandlabs/ai": "workspace:*",
		"@melandlabs/contracts": "workspace:*",
		"@melandlabs/indexeddb": "workspace:*",
		"@melandlabs/loop": "workspace:*",
		"@melandlabs/memory-store": "workspace:*",
		"@melandlabs/rag": "workspace:*",
		"@melandlabs/shared": "workspace:*",
		"@melandlabs/sqlite": "workspace:*",
		"@melandlabs/config": "workspace:*",
		"@types/node": "^22.13.10",
		"tsup": "^8.0.0",
		"typescript": "^5.6.3"
	},
	"scripts": {
		"build": "tsup",
		"prepublishOnly": "pnpm build",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"exports": {
		".": "./dist/index.js"
	}
}
