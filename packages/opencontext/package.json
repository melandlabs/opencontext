		"@melandlabs/integrations": "workspace:*",
		"@melandlabs/loop": "workspace:*",
		"@melandlabs/memory-store": "workspace:*",
		"@melandlabs/rag": "workspace:*",
		"@melandlabs/search": "workspace:*",
