{
	"name": "@melandlabs/contracts",
	"version": "0.6.0",
	"type": "module",
	"files": ["dist", "README.md", "LICENSE"],
	"publishConfig": {
		"access": "public"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": "./dist/index.js",
		"./user-type": "./dist/user-type.js",
		"./integration-id": "./dist/integration-id.js",
		"./entity-type": "./dist/entity-type.js",
		"./entity-edge": "./dist/entity-edge.js",
		"./derived-fact": "./dist/derived-fact.js",
		"./episode": "./dist/episode.js",
		"./decision": "./dist/decision.js",
		"./errors": "./dist/errors.js",
		"./peer": "./dist/peer.js",
		"./schemas": "./dist/schemas.js",
		"./fact-type": "./dist/fact-type.js",
		"./vsa-fact": "./dist/vsa-fact.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/melandlabs/opencontext.git",
		"directory": "packages/contracts"
	},
	"license": "Apache-2.0",
	"description": "Cross-cutting type contracts (UserType, IntegrationId, error codes, zod schemas) shared between OpenContext runtime and UI sub-projects.",
	"keywords": ["opencontext", "contracts", "types", "schemas"],
	"peerDependencies": {
		"zod": "^4.3.6"
	},
	"peerDependenciesMeta": {
		"zod": {
			"optional": true
		}
	},
	"devDependencies": {
		"@melandlabs/config": "workspace:*",
		"typescript": "^5.6.3",
		"vitest": "^2.1.0",
		"zod": "^4.3.6"
	},
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest"
	}
}
