			"optional": true
		}
	},
	"devDependencies": {
		"@melandlabs/config": "workspace:*",
		"typescript": "^5.6.3",
		"zod": "^4.3.6"
	},
	"scripts": {
		"build": "tsup",
		"prepublishOnly": "pnpm build",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
