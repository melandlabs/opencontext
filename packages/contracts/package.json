		"./user-type": "./dist/user-type.js",
		"./integration-id": "./dist/integration-id.js",
		"./errors": "./dist/errors.js",
		"./schemas": "./dist/schemas.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/melandlabs/opencontext.git",
		"directory": "packages/contracts"
	},
	"license": "Apache-2.0",
	"description": "Cross-cutting type contracts (UserType, IntegrationId, error codes, zod schemas) shared between OpenContext runtime and UI sub-projects.",
	"keywords": [
		"opencontext",
		"contracts",
		"types",
		"schemas"
	],
	"peerDependencies": {
		"zod": "^4.3.6"
	},
	"peerDependenciesMeta": {
