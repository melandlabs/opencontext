    "directory": "packages/config"
  },
  "homepage": "https://github.com/melandlabs/openloomi/tree/main/packages/config",
  "bugs": {
    "url": "https://github.com/melandlabs/openloomi/issues"
  },
  "license": "Apache-2.0",
  "description": "Shared tsup preset and lint/tsconfig presets for OpenLoomi packages.",
  "keywords": ["openloomi", "tsup", "monorepo"],
  "scripts": {
    "build": "tsup",
