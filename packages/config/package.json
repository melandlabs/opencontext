{
	"name": "@melandlabs/config",
	"version": "0.1.4",
	"type": "module",
	"files": ["dist", "src/tsup-preset.mjs", "README.md", "LICENSE"],
	"publishConfig": {
		"access": "public"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.cjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": "./dist/index.cjs",
		"./eslint": "./dist/eslint.cjs",
		"./tsconfig": "./src/tsconfig.json",
		"./tsup-preset": "./src/tsup-preset.mjs"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/melandlabs/opencontext.git",
		"directory": "packages/config"
	},
	"homepage": "https://github.com/melandlabs/opencontext/tree/main/packages/config",
	"bugs": {
		"url": "https://github.com/melandlabs/opencontext/issues"
	},
	"license": "Apache-2.0",
	"description": "Shared tsup preset and lint/tsconfig presets for OpenContext packages.",
	"keywords": ["opencontext", "tsup", "monorepo"],
	"scripts": {
		"build": "tsup",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"tsup": {
		"entry": {
			"index": "src/index.js",
			"eslint": "src/eslint.js"
		}
	}
}
