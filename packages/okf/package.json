{
	"name": "@melandlabs/okf",
	"version": "0.2.1",
	"type": "module",
	"files": ["dist", "README.md", "LICENSE"],
	"publishConfig": {
		"access": "public"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./http": {
			"types": "./dist/http.d.ts",
			"import": "./dist/http.js"
		},
		"./mcp": {
			"types": "./dist/mcp.d.ts",
			"import": "./dist/mcp.js"
		},
		"./serve": {
			"types": "./dist/serve.d.ts",
			"import": "./dist/serve.js"
		},
		"./graph": {
			"types": "./dist/graph.d.ts",
			"import": "./dist/graph.js"
		},
		"./viewer/*": "./dist/viewer/*"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/melandlabs/opencontext.git",
		"directory": "packages/okf"
	},
	"license": "Apache-2.0",
	"description": "OKF v0.2 (Open Knowledge Format) importer / exporter for OpenContext. Bidirectional Markdown + YAML ↔ RawMessage codec.",
	"keywords": ["opencontext", "okf", "open-knowledge-format", "markdown", "yaml", "wiki"],
	"dependencies": {
		"@melandlabs/contracts": "workspace:*",
		"yaml": "^2.0.0"
	},
	"peerDependencies": {
		"@melandlabs/indexeddb": "workspace:*",
		"@hono/node-server": "^1.13.7",
		"hono": "^4.6.14",
		"zod": "^4.3.6"
	},
	"peerDependenciesMeta": {
		"@melandlabs/indexeddb": {
			"optional": true
		},
		"@hono/node-server": {
			"optional": true
		},
		"hono": {
			"optional": true
		}
	},
	"devDependencies": {
		"@hono/node-server": "^1.13.7",
		"@melandlabs/config": "workspace:*",
		"@melandlabs/memory-store": "workspace:*",
		"@types/node": "^22.13.10",
		"hono": "^4.6.14",
		"typescript": "^5.6.3",
		"vitest": "^2.1.0",
		"zod": "^4.3.6"
	},
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest"
	}
}
