{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"ignoreUnknown": true,
		"ignore": [
			"**/node_modules",
			"**/dist",
			"**/.next",
			"**/coverage",
			"**/.turbo",
			"**/.vite",
			"**/CHANGELOG.md",
			"**/*.generated.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 110
	},
	"organizeImports": { "enabled": true },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"complexity": {
				"noForEach": "warn",
				"noBannedTypes": "warn"
			},
			"style": {
				"noNonNullAssertion": "warn",
				"useImportType": "error",
				"useNodejsImportProtocol": "error",
				"useConst": "error"
			},
			"suspicious": {
				"noExplicitAny": "warn",
				"noConsole": "warn",
				"noControlCharactersInRegex": "warn",
				"noAssignInExpressions": "warn"
			},
			"correctness": {
				"noUnusedVariables": "warn",
				"noUnusedImports": "warn",
				"noSwitchDeclarations": "warn",
				"useExhaustiveDependencies": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all",
			"arrowParentheses": "always"
		}
	}
}
