# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-plugins)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrals

# dotenv environment variable files
.env
.env.*
!.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist
.output

# Gatsby files
.cache/

# vuepress build output
.vuepress/dist

# vuepress v2.x temp directory
.temp

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# pnpm
.pnpm-store

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# macOS
.DS_Store

# opencontext-specific
.turbo
.vercel
.opencontext/
packages/*/dist/
packages/*/.tsbuildinfo
packages/ai/*/dist/
packages/integrations/*/dist/
# examples scratch dirs — demos that touch the filesystem clean up after
# themselves, but a crashed run can leave these behind
examples/.tmp/
examples/data/
# examples/ is private; its lockfile is regenerated on every smoke-test
# `pnpm install --ignore-workspace` run. Tracking it leads to stale
# lockfiles that conflict with the just-bumped manifest specifiers.
examples/pnpm-lock.yaml

# Generated SQLite databases from tutorial runs
tutorials-*.db

# Temporary scratch directories created by demos
.tmp/

# benchmark runs — Python venvs, caches, and regenerable run artifacts
.venv*/
__pycache__/
.pytest_cache/
.ruff_cache/
benchmark/**/outputs/
benchmark/**/results/
benchmark/**/final_results/
benchmark/**/cloned_repos/
# benchmark local daemon data (memory db, logs)
benchmark/.opencontext-data/
# AML local eval outputs (the AML pipeline sources are vendored in-repo)
benchmark/aml-local/outputs/
benchmark/aml-local/outputs-*/
# benchmark local secrets (API keys used by eval harnesses)
benchmark/**/.qwen_key_.txt
# benchmark run artifacts (checkpoints, per-run score files, egg-info)
benchmark/**/checkpoints/
benchmark/**/results*.json
benchmark/**/*.egg-info/
# benchmark datasets and reference binaries (large, re-downloadable — see each benchmark's README)
benchmark/locomo/dataset/
benchmark/longmemeval/dataset/
benchmark/clbench-official/dataset/
benchmark/clbench-official/CL-bench-*.jsonl
benchmark/beam/dataset/*.parquet
benchmark/beam/dataset/beam_1m.json
benchmark/beam/dataset/beam_10m.json
benchmark/scriptmem/dataset/raw/
benchmark/scriptmem/dataset/scripts/

# AML local experiment helpers (local-only probes/builders, not for upstream)
benchmark/aml-local/_probe_openrouter.py
benchmark/aml-local/_lme_sample100_ids.txt
benchmark/aml-local/build_union.py
