# Version control & local state
.git
**/.DS_Store
*.log

# Node — never copy host node_modules into the Linux image
node_modules
**/node_modules
**/dist
!packages/opencontext/dist
.pnpm-store

# Benchmark data & run artifacts (large / regenerable)
benchmark/**/dataset
benchmark/**/.data
benchmark/**/checkpoints
benchmark/.opencontext-data
benchmark/aml-local/outputs*
benchmark/AML-agent-memory-leaderboard/.venv
**/.venv

# The runtime image copies only these two adapter files from benchmark/.
# Exclude all benchmark datasets, run artifacts, and historical outputs from
# the build context so local evaluation artifacts cannot make Docker uploads
# multi-gigabyte.
benchmark/*
!benchmark/aml-local/
benchmark/aml-local/*
!benchmark/aml-local/serve.py
!benchmark/aml-local/docker-entrypoint.sh

# Temp scripts
.tmp-*

# Local env / secrets
**/.env
**/.env.*
!**/.env.example
