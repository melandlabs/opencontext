# OpenContext LLM configuration for the reasoning-backed memory layer.
#
# Copy this file to .env and fill in your values.
# The OpenContext facade reads these environment variables at runtime.
# In Node.js 22+ you can load them with: node --env-file=.env
# Or install dotenv and import "dotenv/config" in your entry file.

# OpenAI-compatible endpoint.
# Examples: OpenRouter, DeepSeek, OpenAI, or any compatible proxy.
OPENCONTEXT_LLM_BASE_URL=your-base-url-here

# API key for the above endpoint.
OPENCONTEXT_LLM_API_KEY=your-api-key-here

# Model identifier used by the query rewriter and iterative recall planner.
# The exact value depends on your provider (e.g. deepseek-chat, openai/gpt-4o-mini).
OPENCONTEXT_LLM_MODEL=you-model-here

# Optional: tuning knobs for the iterative recall planner.
# OPENCONTEXT_LLM_REASONING_MAX_ITERATIONS=4
# OPENCONTEXT_LLM_REASONING_SEARCH_TOP_K=5

# Optional: max number of rewritten query variants the rewriter asks the
# LLM for in addition to the original. 0 disables rewriting. Higher values
# multiply embedding + search cost, so keep it small (1–3 is typical).
# OPENCONTEXT_LLM_REWRITER_MAX_VARIANTS=1
